{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"detail": "Headless STM32CubeIDE build (Debug) -> Debug/stm32f411-freertos-keypad.elf",
			"type": "process",
			"command": "/Applications/STM32CubeIDE.app/Contents/MacOS/STM32CubeIDE",
			"args": [
				"--launcher.suppressErrors",
				"-nosplash",
				"-application", "org.eclipse.cdt.managedbuilder.core.headlessbuild",
				"-data", "${env:HOME}/.stm32cubeide-headless-ws",
				"-import", "${workspaceFolder}",
				"-build", "stm32f411-freertos-keypad/Debug"
			],
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": {
				"base": "$gcc",
				"fileLocation": ["relative", "${workspaceFolder}/Debug"]
			}
		},
		{
			"label": "Build (make, fast)",
			"detail": "Incremental make in Debug/ with STM32CubeIDE's GCC 14.3 (run the full Build once first)",
			"type": "shell",
			"command": "make -C Debug -j8 all",
			"options": {
				"env": {
					"PATH": "/Applications/STM32CubeIDE.app/Contents/Eclipse/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.macos64_1.0.100.202602081740/tools/bin:${env:PATH}"
				}
			},
			"group": "build",
			"problemMatcher": {
				"base": "$gcc",
				"fileLocation": ["relative", "${workspaceFolder}/Debug"]
			}
		},
		{
			"label": "Clean",
			"type": "process",
			"command": "/Applications/STM32CubeIDE.app/Contents/MacOS/STM32CubeIDE",
			"args": [
				"--launcher.suppressErrors",
				"-nosplash",
				"-application", "org.eclipse.cdt.managedbuilder.core.headlessbuild",
				"-data", "${env:HOME}/.stm32cubeide-headless-ws",
				"-import", "${workspaceFolder}",
				"-cleanBuild", "stm32f411-freertos-keypad/Debug"
			],
			"problemMatcher": []
		},
		{
			"label": "Flash",
			"detail": "Build, then program the board over the on-board ST-LINK with OpenOCD",
			"type": "process",
			"command": "openocd",
			"args": [
				"-f", "board/stm32f4discovery.cfg",
				"-c", "program {${workspaceFolder}/Debug/stm32f411-freertos-keypad.elf} verify reset exit"
			],
			"dependsOn": "Build",
			"problemMatcher": []
		}
	]
}
