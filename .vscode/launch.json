{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug (OpenOCD, ST-LINK)",
			"type": "cortex-debug",
			"request": "launch",
			"servertype": "openocd",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/Debug/stm32f411-freertos-keypad.elf",
			"configFiles": ["board/stm32f4discovery.cfg"],
			"gdbPath": "/Applications/STM32CubeIDE.app/Contents/Eclipse/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.macos64_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb",
			"rtos": "FreeRTOS",
			"runToEntryPoint": "main",
			"preLaunchTask": "Build"
		}
	]
}
